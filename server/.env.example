# MongoDB connection string (MongoDB Atlas free tier works well with Render)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ikz-datatool?retryWrites=true&w=majority

# REQUIRED. Long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=5000

# Only needed when running client (Vite) and server on different origins in development
CLIENT_URL=http://localhost:5173

# Where uploaded attachments are stored. On Render, point this at the persistent disk: /var/data/uploads
UPLOAD_DIR=./uploads

# First admin account. Created automatically on startup if no admin exists yet.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_password

# Set to "false" to stop the server from seeding reference lists/questions/plan template on startup
AUTO_SEED=true
